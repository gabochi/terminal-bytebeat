#!/bin/bash
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"

PY=/usr/bin/python3
VENV=venv-system

if [ ! -d "$VENV" ]; then
    echo "[run-3d] Creating venv with $($PY --version) ..."
    $PY -m venv "$VENV"
fi
. "$VENV/bin/activate"
pip install -q -r requirements.txt

exec python3 eb_3d.py "$@"
